{
  "expo": {
    "name": "posterBox",
    "slug": "posterBox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "posterbox",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#AA0000",
        "foregroundImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PosterBox to access your photos for KYC verification.",
          "cameraPermission": "Allow PosterBox to use your camera for KYC verification.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#AA0000",
          "image": "./assets/images/logo.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#AA0000",
            "image": "./assets/images/logo.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
